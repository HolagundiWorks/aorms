# AORMS web (Next.js) — Supabase project credentials.
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. NEXT_PUBLIC_* vars are exposed to the browser —
# never put the service role key in one of those.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Route Handlers / Server Actions that need to bypass RLS
# (admin operations). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AORMS Platform — the separate central identity/licensing Supabase project
# (portable AORMS-U-/AORMS-C- accounts, companies, memberships, usage
# hours/level). Locally this is `platform/supabase/` (its own `supabase
# start`); in production it would be a separate deployed Supabase project.
NEXT_PUBLIC_PLATFORM_SUPABASE_URL=
NEXT_PUBLIC_PLATFORM_SUPABASE_ANON_KEY=
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 enqueue boundary (docs/esti/NEXTJS-MIGRATION-PHASE6-AUDIT.md) — the
# gateway/ service fronting the Python worker's Redis Streams job bus.
# JOBS_GATEWAY_URL: e.g. https://jobs.aorms.in (the VPS-hosted gateway).
# JOBS_GATEWAY_TOKEN: must match the gateway's own JOBS_GATEWAY_TOKEN exactly.
JOBS_GATEWAY_URL=
JOBS_GATEWAY_TOKEN=
