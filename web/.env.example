# AORMS web (Next.js) — Supabase project credentials.
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. NEXT_PUBLIC_* vars are exposed to the browser —
# never put the service role key in one of those.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Route Handlers / Server Actions that need to bypass RLS
# (admin operations). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AORMS Platform — the separate central identity/licensing Supabase project
# (portable AORMS-U-/AORMS-C- accounts, companies, memberships, usage
# hours/level). Locally this is `platform/supabase/` (its own `supabase
# start`); in production it would be a separate deployed Supabase project.
NEXT_PUBLIC_PLATFORM_SUPABASE_URL=
NEXT_PUBLIC_PLATFORM_SUPABASE_ANON_KEY=
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 enqueue boundary (docs/esti/NEXTJS-MIGRATION-PHASE6-AUDIT.md) — the
# gateway/ service fronting the Python worker's Redis Streams job bus.
# JOBS_GATEWAY_URL: e.g. https://jobs.aorms.in (the VPS-hosted gateway).
# JOBS_GATEWAY_TOKEN: must match the gateway's own JOBS_GATEWAY_TOKEN exactly.
JOBS_GATEWAY_URL=
JOBS_GATEWAY_TOKEN=

# ESTI AI agent (Ask ESTI, web/lib/ai/ollama.ts) — talks to Ollama's plain
# HTTP API. In LOCAL DEV, leaving these unset is fine: ollama.ts defaults to
# 127.0.0.1:11434 / llama3.2, matching a native Windows `ollama serve`
# install (see CLAUDE.md § AORMS AI). In PRODUCTION on Hostinger there is no
# local Ollama process next to the Next.js app — OLLAMA_BASE_URL MUST be set
# to a real, reachable Ollama endpoint (a separately hosted/self-hosted
# instance) or every "Ask ESTI" request will silently fail (connection
# refused to 127.0.0.1, which doesn't exist on the app host). OLLAMA_MODEL
# must match a model actually pulled on that endpoint.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# NOT CURRENTLY USED — grepped zero references anywhere in web/ (2026-09-09
# hosting-prep audit). Present in some deployed .env files as leftover
# config from an earlier approach; safe to leave unset. Kept here,
# documented rather than silently dropped, so a future deployer who spots
# it in an existing .env doesn't wonder whether it's a missed wiring step.
# If Supabase JWT verification via a JWKS endpoint is ever added directly
# (bypassing supabase-js), wire it up and remove this comment.
SUPABASE_JWKS_URL=
