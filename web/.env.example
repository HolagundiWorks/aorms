# AORMS web (Next.js) — Supabase project credentials.
# Create a project at https://supabase.com, then copy these from
# Project Settings → API. NEXT_PUBLIC_* vars are exposed to the browser —
# never put the service role key in one of those.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Route Handlers / Server Actions that need to bypass RLS
# (admin operations). Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AORMS Platform — the separate central identity/licensing Supabase project
# (portable AORMS-U-/AORMS-C- accounts, companies, memberships, usage
# hours/level). Locally this is `platform/supabase/` (its own `supabase
# start`); in production it would be a separate deployed Supabase project.
NEXT_PUBLIC_PLATFORM_SUPABASE_URL=
NEXT_PUBLIC_PLATFORM_SUPABASE_ANON_KEY=
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=

# Phase 6 enqueue boundary (docs/esti/NEXTJS-MIGRATION-PHASE6-AUDIT.md) — the
# gateway/ service fronting the Python worker's Redis Streams job bus.
# JOBS_GATEWAY_URL: e.g. https://jobs.aorms.in (the VPS-hosted gateway).
# JOBS_GATEWAY_TOKEN: must match the gateway's own JOBS_GATEWAY_TOKEN exactly.
JOBS_GATEWAY_URL=
JOBS_GATEWAY_TOKEN=

# ESTI AI agent (Ask ESTI, web/lib/ai/ollama.ts) — talks to Ollama's plain
# HTTP API. In LOCAL DEV, leaving these unset is fine: ollama.ts defaults to
# 127.0.0.1:11434 / llama3.2, matching a native Windows `ollama serve`
# install (see CLAUDE.md § AORMS AI). In PRODUCTION on Hostinger there is no
# local Ollama process next to the Next.js app — OLLAMA_BASE_URL MUST be set
# to a real, reachable Ollama endpoint (a separately hosted/self-hosted
# instance) or every "Ask ESTI" request will silently fail (connection
# refused to 127.0.0.1, which doesn't exist on the app host). OLLAMA_MODEL
# must match a model actually pulled on that endpoint.
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ESTI Pulse (docs/esti/ESTI-PULSE.md, ported 2026-09-12, RAG/NL
# interpreter made fully deterministic 2026-09-13) — no Ollama dependency
# for Pulse's RAG (Postgres full-text search) or its NL interpreter
# (keyword/pattern matching), by explicit direction. OLLAMA_BASE_URL/
# OLLAMA_MODEL above are only for the pre-existing Ask ESTI/Daily Brief/
# AI Studio features, unaffected by this change.

# Bearer secret gating app/api/pulse/recompute/route.ts — the same value
# must be baked into the `pg_cron`/`pg_net` job scheduled in migration
# 0038 (`Authorization: Bearer <this value>`), since that job calls the
# route directly over HTTP, not through Supabase auth. Generate with
# `openssl rand -hex 32` or similar; treat it as seriously as a webhook
# secret — anyone with it can trigger a full task recompute pass.
PULSE_RECOMPUTE_SECRET=

# NOT CURRENTLY USED — grepped zero references anywhere in web/ (2026-09-09
# hosting-prep audit). Present in some deployed .env files as leftover
# config from an earlier approach; safe to leave unset. Kept here,
# documented rather than silently dropped, so a future deployer who spots
# it in an existing .env doesn't wonder whether it's a missed wiring step.
# If Supabase JWT verification via a JWKS endpoint is ever added directly
# (bypassing supabase-js), wire it up and remove this comment.
SUPABASE_JWKS_URL=

# Razorpay — AORMS Platform licence payments (web/lib/platform/razorpay.ts,
# 2026-09-09). Get RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET from the Razorpay
# dashboard (Settings → API Keys) — use TEST mode keys for local dev, LIVE
# mode only in production once real pricing is confirmed on /admin/pricing.
# RAZORPAY_WEBHOOK_SECRET is a separate secret Razorpay generates when you
# register the webhook URL (Settings → Webhooks →
# https://aorms.in/api/razorpay/webhook, events: payment.captured,
# payment.failed) — not the same value as RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID, duplicated under NEXT_PUBLIC_ — Razorpay's
# key id is not secret (it's the key SECRET that must never be exposed),
# and Checkout.js needs it client-side to open the payment sheet.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudflare Turnstile CAPTCHA. Site key is public by design.
# platform-login/platform-signup are verified natively by Supabase Auth
# (security_captcha_provider="turnstile", configured on aorms-platform
# only — see lib/security/turnstile.ts's header for why). forgot-password
# is verified manually using TURNSTILE_SECRET_KEY (server-only, never
# expose to the client) — see that same file.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Staff two-factor (TOTP) for SysDeX — see lib/platform/mfa.ts. Leave unset/false until
# every staff member has enrolled at /platform-mfa and confirmed a code works; then set
# to "true" to require AAL2 for all /admin/* pages and admin Server Actions.
STAFF_MFA_REQUIRED=false

# Transactional email (HelpDeX replies, licence-expiry reminders) — lib/email/send.ts.
# Leave SMTP_HOST unset to disable: replies are still saved, reminders do nothing.
# The Hostinger mailbox already used for Supabase Auth works: smtp.hostinger.com / 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Shared secret for /api/cron/licence-reminders (send as "Authorization: Bearer <value>").
CRON_SECRET=
