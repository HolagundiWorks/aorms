{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AORMS Studio",
  "version": "0.1.0",
  "identifier": "in.aorms.studio",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AORMS Studio",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Human Centric Works",
    "shortDescription": "AORMS Studio — architecture practice management",
    "longDescription": "Local-first AORMS Studio desktop node. Sign in, bind a licence to the AORMS hub, and sync metadata when licensed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {}
}
