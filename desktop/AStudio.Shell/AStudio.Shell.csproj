<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AStudio.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Unpackaged: run without MSIX for unsigned Bhoomi builds -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AormsDesktopProfile Condition="'$(AormsDesktopProfile)' == ''">STUDIO</AormsDesktopProfile>
    <ApplicationTitle Condition="'$(AormsDesktopProfile)' == 'CONSULTANCY'">AORMS Consultancy</ApplicationTitle>
    <ApplicationTitle Condition="'$(AormsDesktopProfile)' != 'CONSULTANCY'">AORMS Studio</ApplicationTitle>
    <AssemblyName Condition="'$(AormsDesktopProfile)' == 'CONSULTANCY'">AConsulting.Shell</AssemblyName>
    <AssemblyName Condition="'$(AormsDesktopProfile)' != 'CONSULTANCY'">AStudio.Shell</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AormsDesktopProfile)' == 'CONSULTANCY'">
    <DefineConstants>$(DefineConstants);AORMS_PROFILE_CONSULTANCY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AormsDesktopProfile)' != 'CONSULTANCY'">
    <DefineConstants>$(DefineConstants);AORMS_PROFILE_STUDIO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
</Project>
