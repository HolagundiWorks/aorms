<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AStudio.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AORMS Studio">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fluent 2 custom title bar + native menu (DESKTOP-WEB-PARITY) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock
                    x:Name="ProductLabel"
                    Text="AORMS"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
                <MenuBar VerticalAlignment="Center">
                    <MenuBarItem x:Name="MenuProject" Title="Project" />
                    <MenuBarItem x:Name="MenuEdit" Title="Edit" />
                    <MenuBarItem x:Name="MenuView" Title="View" />
                    <MenuBarItem x:Name="MenuAi" Title="AI" />
                    <MenuBarItem x:Name="MenuHelp" Title="Help" />
                </MenuBar>
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Opacity="0.7"
                Text="Loading…" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="Reload SPA" Click="OnReloadClick" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Start stack" Click="OnStartStackClick" />
            </StackPanel>
        </Grid>

        <WebView2
            x:Name="SpaView"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <InfoBar
            Grid.Row="2"
            IsOpen="True"
            IsClosable="True"
            Severity="Informational"
            Title="Local-first node"
            Message="SPA stage uses @hcw/ui-kit. Fluent 2 applies to OS chrome only (title bar · menu · tray)." />
    </Grid>
</Window>
