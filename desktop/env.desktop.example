# AORMS desktop node — copy into the packaged runtime env (not committed secrets).
ESTI_ROLE=node
ESTI_DESKTOP=true
STORAGE_DRIVER=fs
STORAGE_DIR=./.esti-files
INSTALL_ID=
ESTI_HUB_URL=https://aorms.in
ESTI_LICENSE_API_URL=https://aorms.in/platform
# ESTI_PRODUCT_API_KEY=
DATABASE_URL=postgres://esti:esti@127.0.0.1:5432/esti
REDIS_URL=redis://127.0.0.1:6379
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
EOMS_API_URL=http://127.0.0.1:8756
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost
VITE_API_URL=http://127.0.0.1:4000
VITE_RUNTIME_HOST=desktop
