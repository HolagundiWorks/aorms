# AORMS desktop node — copy into the packaged runtime env (not committed secrets).
ESTI_ROLE=node
ESTI_DESKTOP=true
STORAGE_DRIVER=fs
STORAGE_DIR=./.esti-files
INSTALL_ID=
ESTI_HUB_URL=https://aorms.in
ESTI_LICENSE_API_URL=https://aorms.in/platform
# ESTI_PRODUCT_API_KEY=
#
# Local Docker hub (desktop WinUI firm.db is SQLite — do not point Bridge at Postgres):
#   ESTI_HUB_URL=http://127.0.0.1:4000
#   ESTI_LICENSE_API_URL=http://127.0.0.1:4000/platform
#   ESTI_PRODUCT_API_KEY=hlp_sk_local_desktop_dev_do_not_use_in_prod
#   docker compose exec backend pnpm --filter @esti/backend seed:desktop-local-hub
#   AStudio: run-local-hub.cmd  (see AStudio/docs/LOCAL-HUB.md)
DATABASE_URL=postgres://esti:esti@127.0.0.1:5432/esti
REDIS_URL=redis://127.0.0.1:6379
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
EOMS_API_URL=http://127.0.0.1:8756
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost
VITE_API_URL=http://127.0.0.1:4000
VITE_RUNTIME_HOST=desktop
