# Port this gateway's HTTP+WS server listens on.
PORT=4200

# Bearer token the AORMS Esti API (web/) must present to POST /infer.
# Server-to-server only — never given to a device. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
DEVICE_GATEWAY_CONTROL_TOKEN=

# aorms-web Supabase project (same one web/ itself uses) — service-role
# key, since this gateway only ever touches the ai_devices table
# (migration 0043), never project/task/client data.
AORMS_SUPABASE_URL=
AORMS_SUPABASE_SERVICE_ROLE_KEY=

# How long to wait for a device's inference_response before giving up
# (guide §27: local inference can be slow — normal web-request timeouts
# don't apply). Milliseconds.
INFERENCE_TIMEOUT_MS=180000
