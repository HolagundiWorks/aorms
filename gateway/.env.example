# Jobs gateway — the Phase 6 enqueue boundary (docs/esti/NEXTJS-MIGRATION-PHASE6-AUDIT.md).
# Bearer token web/'s Server Actions must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
JOBS_GATEWAY_TOKEN=

# Same Redis + stream the Python worker (worker/) consumes from — must match
# worker/.env's REDIS_URL / WORKER_JOB_STREAM exactly, they're the same queue.
REDIS_URL=redis://localhost:6379
WORKER_JOB_STREAM=esti:jobs

PORT=4100
